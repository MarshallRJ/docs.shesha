<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
            <remove fileExtension=".json"/>
            <mimeMap fileExtension=".json" mimeType="application/json"/>
            <!-- Serve .md files as plain text so browsers display them instead of prompting download -->
            <mimeMap fileExtension=".md" mimeType="text/plain"/>
        </staticContent>

        <!--
            URL Rewrite outbound rules add response headers only for .md file requests.
            Requires the URL Rewrite module (pre-installed on Azure Web Apps).
            These headers:
              - Set explicit charset on Content-Type
              - Prevent MIME sniffing
              - Block search engine indexing (avoids duplicate content SEO issues)
              - Set a short cache TTL appropriate for documentation
        -->
        <rewrite>
            <outboundRules>
                <rule name="MD - Content-Type charset">
                    <match serverVariable="RESPONSE_Content_Type" pattern=".*"/>
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="\.md$"/>
                    </conditions>
                    <action type="Rewrite" value="text/plain; charset=utf-8"/>
                </rule>
                <rule name="MD - X-Content-Type-Options">
                    <match serverVariable="RESPONSE_X_Content_Type_Options" pattern=".*"/>
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="\.md$"/>
                    </conditions>
                    <action type="Rewrite" value="nosniff"/>
                </rule>
                <rule name="MD - X-Robots-Tag">
                    <match serverVariable="RESPONSE_X_Robots_Tag" pattern=".*"/>
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="\.md$"/>
                    </conditions>
                    <action type="Rewrite" value="googlebot: noindex, nofollow, bingbot: noindex, nofollow"/>
                </rule>
                <rule name="MD - Cache-Control">
                    <match serverVariable="RESPONSE_Cache_Control" pattern=".*"/>
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="\.md$"/>
                    </conditions>
                    <action type="Rewrite" value="public, max-age=3600, must-revalidate"/>
                </rule>
            </outboundRules>
        </rewrite>
    </system.webServer>
</configuration>
